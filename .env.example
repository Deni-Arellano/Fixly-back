# Puerto del servidor
PORT=3000

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=fixly_db
DB_PORT=3306

# JsonWebToken (JWT)
SECRET_JWT_KEY=tu_clave_secreta_jwt_aqui

# Cloudinary (Almacenamiento de imágenes de perfil)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Configuración inicial Super Administrador (Script setup)
SUPER_EMAIL=admin@fixly.com
SUPER_PW=tu_contraseña_segura

